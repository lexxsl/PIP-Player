{
  "manifest_version": 3,
  "name": "PIP-Player",
  "version": "2.1.1",
  "description": "Play web videos in picture-in-picture, remember the window size locally, and keep the full video visible when switching videos.",
  "minimum_chrome_version": "130",
  "permissions": [
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "切换画中画（Alt+P）",
    "default_icon": {
      "16": "assets/icon16.png",
      "19": "assets/icon19.png",
      "32": "assets/icon32.png",
      "38": "assets/icon38.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      }
    }
  }
}
